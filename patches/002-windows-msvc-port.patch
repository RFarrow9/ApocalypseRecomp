diff --git a/ps1Runtime/include/runtime/platform_compat.h b/ps1Runtime/include/runtime/platform_compat.h
new file mode 100644
index 0000000..30ae785
--- /dev/null
+++ b/ps1Runtime/include/runtime/platform_compat.h
@@ -0,0 +1,56 @@
+#pragma once
+// Host-platform shims so the runtime builds with MSVC on Windows.
+//
+// Upstream targets Linux/gcc and uses glibc's <execinfo.h> backtraces and gcc
+// builtins in its diagnostics.  On Windows these map onto the Win32/MSVC
+// equivalents; symbols are printed as raw addresses (resolve them against the
+// PDB), which is enough for the debug paths that use them.
+
+#ifdef _WIN32
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#include <intrin.h>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+#define PS1_RETURN_ADDRESS() _ReturnAddress()
+
+inline int backtrace(void **buffer, int size) {
+  return static_cast<int>(
+      CaptureStackBackTrace(1, static_cast<DWORD>(size), buffer, nullptr));
+}
+
+// glibc contract: one malloc'd block holding the pointer array followed by the
+// strings, released by the caller with a single free().
+inline char **backtrace_symbols(void *const *buffer, int size) {
+  constexpr std::size_t kLen = 2 + 16 + 1;
+  char **out = static_cast<char **>(
+      std::malloc(size * (sizeof(char *) + kLen)));
+  if (!out)
+    return nullptr;
+  char *strings = reinterpret_cast<char *>(out + size);
+  for (int i = 0; i < size; ++i) {
+    out[i] = strings + i * kLen;
+    std::snprintf(out[i], kLen, "0x%llx",
+                  static_cast<unsigned long long>(
+                      reinterpret_cast<uintptr_t>(buffer[i])));
+  }
+  return out;
+}
+
+inline void backtrace_symbols_fd(void *const *buffer, int size, int /*fd*/) {
+  for (int i = 0; i < size; ++i)
+    std::fprintf(stderr, "0x%llx\n",
+                 static_cast<unsigned long long>(
+                     reinterpret_cast<uintptr_t>(buffer[i])));
+}
+#else
+#include <execinfo.h>
+#define PS1_RETURN_ADDRESS() __builtin_return_address(0)
+#endif
