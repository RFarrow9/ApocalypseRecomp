+class GamepadMapper {
+public:
+  void handle(const SDL_Event &e, ps1::input::InputController &input) {
+    switch (e.type) {
+    case SDL_CONTROLLERDEVICEADDED:
+      if (SDL_GameController *c = SDL_GameControllerOpen(e.cdevice.which)) {
+        pads_.push_back(c);
+        fmt::print("[Input] controller connected: {}\n",
+                   SDL_GameControllerName(c));
+      }
+      break;
+    case SDL_CONTROLLERDEVICEREMOVED:
+      for (size_t i = 0; i < pads_.size(); i++) {
+        SDL_Joystick *j = SDL_GameControllerGetJoystick(pads_[i]);
+        if (SDL_JoystickInstanceID(j) == e.cdevice.which) {
+          fmt::print("[Input] controller disconnected\n");
+          SDL_GameControllerClose(pads_[i]);
+          pads_.erase(pads_.begin() + i);
+          break;
+        }
+      }
+      buttons_ = 0;
+      stick_ = 0;
+      triggers_ = 0;
+      apply(input);
+      break;
+    case SDL_CONTROLLERBUTTONDOWN:
+    case SDL_CONTROLLERBUTTONUP:
+      if (uint16_t b = mapButton(e.cbutton.button)) {
+        if (e.type == SDL_CONTROLLERBUTTONDOWN)
+          buttons_ |= b;
+        else
+          buttons_ &= ~b;
+        apply(input);
+      }
+      break;
+    case SDL_CONTROLLERAXISMOTION:
+      axis(e.caxis.axis, e.caxis.value, input);
+      break;
+    }
+  }
