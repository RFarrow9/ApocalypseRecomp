diff --git a/ps1Runtime/include/runtime/cdrom/xa_decoder.h b/ps1Runtime/include/runtime/cdrom/xa_decoder.h
new file mode 100644
index 0000000..980d27c
--- /dev/null
+++ b/ps1Runtime/include/runtime/cdrom/xa_decoder.h
@@ -0,0 +1,42 @@
+#pragma once
+// XA-ADPCM decoder for CD-ROM audio sectors (psx-spx "CDROM XA Audio ADPCM
+// Compression").  One Mode 2 Form 2 sector carries 18 sound groups of 128
+// bytes; each group holds 8 (4-bit) or 4 (8-bit) sound units of 28 samples.
+// Output is resampled to the SPU's 44.1 kHz and interleaved stereo (mono
+// sources are duplicated to both channels).
+
+#include <cstdint>
+#include <vector>
+
+namespace ps1::cdrom {
+
+class XaDecoder {
+public:
+  // True when `raw` (a full 2352-byte sector) is an XA audio sector:
+  // subheader submode has Audio (bit 2) and Form 2 (bit 5).
+  static bool isAudioSector(const uint8_t *raw);
+  static uint8_t fileNumber(const uint8_t *raw) { return raw[16]; }
+  static uint8_t channelNumber(const uint8_t *raw) { return raw[17]; }
+
+  // Decode one sector and append 44.1 kHz stereo samples to `out`.
+  void decodeSector(const uint8_t *raw, std::vector<int16_t> &out);
+
+  // Forget filter history and resampler phase (new stream / seek).
+  void reset();
+
+private:
+  void decodeGroup(const uint8_t *group, bool stereo, bool eightBit,
+                   std::vector<int16_t> &left, std::vector<int16_t> &right);
+  void resampleInto(const std::vector<int16_t> &left,
+                    const std::vector<int16_t> &right, uint32_t srcRate,
+                    std::vector<int16_t> &out);
+
+  int32_t old_[2] = {0, 0};   // per channel: last sample
+  int32_t older_[2] = {0, 0}; // per channel: the one before
+  // Resampler state: fractional read position carried across sectors, and
+  // the last source frame so interpolation spans the sector boundary.
+  double phase_ = 0.0;
+  int16_t lastL_ = 0, lastR_ = 0;
+};
+
+} // namespace ps1::cdrom
diff --git a/ps1Runtime/include/runtime/disc_setup.h b/ps1Runtime/include/runtime/disc_setup.h
new file mode 100644
index 0000000..d85d944
--- /dev/null
+++ b/ps1Runtime/include/runtime/disc_setup.h
@@ -0,0 +1,34 @@
+#pragma once
+// First-run disc setup for a packaged game: find the player's disc image,
+// check it is the right game, and extract its boot executable.
+
+#include <filesystem>
+#include <optional>
+#include <string>
+
+namespace ps1 {
+
+struct DiscPaths {
+  std::string cue; // the disc image the CD-ROM mounts
+  std::string exe; // boot executable extracted from it
+};
+
+// `settingsIni` holds `disc=<path>` from an earlier run (the overlay keeps
+// the rest of that file).  `expectedBoot` is the boot file name the game's
+// config names (e.g. "SLES_004.60"; empty accepts any disc).  `given` is a
+// disc image passed on the command line or dropped onto the executable.
+// Asks the player with a file dialog when nothing usable is known, and
+// remembers the choice.  Returns nullopt when the player cancels.
+std::optional<DiscPaths> resolveDisc(const std::filesystem::path &settingsIni,
+                                     const std::filesystem::path &cacheDir,
+                                     const std::string &gameName,
+                                     const std::string &expectedBoot,
+                                     const std::string &given);
+
+// Extracts the boot executable from the data track of `cue` into
+// `cacheDir`.  `bootName` receives the file name SYSTEM.CNF names.
+std::optional<std::string> extractBootExe(const std::filesystem::path &cue,
+                                          const std::filesystem::path &cacheDir,
+                                          std::string *bootName);
+
+} // namespace ps1
