+void Overlay::addCheat(const std::string &name,
+                       const std::vector<std::string> &pokes) {
+  Cheat c;
+  c.name = name;
+  for (std::string p : pokes) {
+    CheatAction a;
+    if (const size_t cond = p.find(" if "); cond != std::string::npos) {
+      const std::string c = p.substr(cond + 4);
+      const size_t eq = c.find('=');
+      if (eq != std::string::npos) {
+        a.when = parseChain(c.substr(0, eq));
+        a.whenValue =
+            static_cast<uint32_t>(std::strtoul(c.substr(eq + 1).c_str(), nullptr, 16));
+      }
+      p = p.substr(0, cond);
+    }
+    if (p.rfind("call ", 0) == 0) {
+      // call <func> <a0 chain> <a1> [unless <chain>]
+      std::istringstream in(p.substr(5));
+      std::string func, a0, a1, kw, guard;
+      in >> func >> a0 >> a1 >> kw >> guard;
+      a.isCall = true;
+      a.func = static_cast<uint32_t>(std::strtoul(func.c_str(), nullptr, 16));
+      a.target = parseChain(a0);
+      a.value = static_cast<uint32_t>(std::strtoul(a1.c_str(), nullptr, 16));
+      if (kw == "unless")
+        a.unless = parseChain(guard);
+    } else {
+      const size_t eq = p.find('=');
+      if (eq == std::string::npos)
+        continue;
+      a.target = parseChain(p.substr(0, eq));
+      std::string val = p.substr(eq + 1);
+      if (const size_t colon = val.find(':'); colon != std::string::npos) {
+        a.width = val[colon + 1] == 'b' ? 1 : val[colon + 1] == 'h' ? 2 : 4;
+        val = val.substr(0, colon);
+      }
+      a.value = static_cast<uint32_t>(std::strtoul(val.c_str(), nullptr, 16));
+    }
+    c.actions.push_back(std::move(a));
+  }
+  if (!c.actions.empty())
+    settings_.cheats.push_back(std::move(c));
+}
+
+void Overlay::applyCheats(const CheatHost &host) {
+  for (const Cheat &c : settings_.cheats) {
+    if (!c.enabled)
+      continue;
+    for (const CheatAction &a : c.actions) {
+      uint32_t addr = 0;
+      if (!a.when.empty() &&
+          (!resolve(a.when, host, addr) || host.read32(addr) != a.whenValue))
+        continue;
+      if (!resolve(a.target, host, addr))
+        continue;
+      if (!a.isCall) {
+        host.write(addr, a.value, a.width);
+        continue;
+      }
+      // The call's a0 is the chain's result as a value (e.g. the player
+      // object), which is the resolved address itself.
+      if (!isRam(addr))
+        continue;
+      uint32_t guard = 0;
+      if (!a.unless.empty() &&
+          (!resolve(a.unless, host, guard) || host.read32(guard) != 0))
+        continue;
+      host.call(a.func, addr, a.value);
+    }
+  }
+}
+
+void Overlay::setOpen(bool open) {
+  open_ = open;
+  SDL_Log("[Overlay] %s", open ? "opened" : "closed");
+  confirmQuit_ = false;
+  if (!open)
+    save();
+}
+
+bool Overlay::handleEvent(const SDL_Event &e) {
+  if (!ready_)
+    return false;
+  // Open/close: F1 or Esc, or Back+Start together on a controller.
+  if (e.type == SDL_KEYDOWN && !e.key.repeat &&
+      (e.key.keysym.sym == SDLK_F1 || e.key.keysym.sym == SDLK_ESCAPE)) {
+    setOpen(!open_);
+    return true;
+  }
+  if (e.type == SDL_CONTROLLERBUTTONDOWN &&
+      (e.cbutton.button == SDL_CONTROLLER_BUTTON_BACK ||
+       e.cbutton.button == SDL_CONTROLLER_BUTTON_START) &&
+      chordHeld(e.cbutton.which)) {
+    setOpen(!open_);
+    return true;
+  }
+  if (!open_)
+    return false;
+  ImGui_ImplSDL2_ProcessEvent(&e);
+  // Hotplug still has to reach the pad mapper; everything else is ours.
+  return e.type != SDL_CONTROLLERDEVICEADDED &&
+         e.type != SDL_CONTROLLERDEVICEREMOVED && e.type != SDL_QUIT;
+}
+
+void Overlay::draw() {
+  if (!ready_ || !open_)
+    return;
+  ImGui_ImplOpenGL3_NewFrame();
+  ImGui_ImplSDL2_NewFrame();
+  ImGui::NewFrame();
+
+  const ImGuiViewport *vp = ImGui::GetMainViewport();
+  const float scale = std::max(1.0f, vp->Size.y / 720.0f);
+  ImGui::GetStyle().FontScaleMain = scale;
+  ImGui::SetNextWindowPos(ImVec2(vp->Size.x * 0.5f, vp->Size.y * 0.5f),
+                          ImGuiCond_Always, ImVec2(0.5f, 0.5f));
+  ImGui::SetNextWindowSize(ImVec2(560 * scale, 0));
+  ImGui::SetNextWindowBgAlpha(0.92f);
+  ImGui::Begin("Settings", nullptr,
+               ImGuiWindowFlags_NoCollapse | ImGuiWindowFlags_NoMove |
+                   ImGuiWindowFlags_NoResize | ImGuiWindowFlags_NoSavedSettings);
+
+  bool changed = false;
+  ImGui::TextDisabled("Game paused.  F1 / Esc / Back+Start to resume.");
+  ImGui::Spacing();
+
+  if (ImGui::CollapsingHeader("Display", ImGuiTreeNodeFlags_DefaultOpen)) {
+    changed |= ImGui::Checkbox("Fullscreen (F11 / Alt+Enter)",
+                               &settings_.fullscreen);
+    changed |= ImGui::Combo("Aspect", &settings_.aspect, kAspectNames,
+                            IM_ARRAYSIZE(kAspectNames));
+    if (settings_.aspect != 0)
+      ImGui::TextWrapped("Widens the 3D view.  Experimental: objects past the "
+                         "original screen edge can pop in, and the HUD is "
+                         "stretched.  Movies stay 4:3.");
+    changed |= ImGui::Combo("Internal resolution", &settings_.resolution,
+                            kResolutionNames, IM_ARRAYSIZE(kResolutionNames));
+    if (settings_.resolution != 0)
+      ImGui::TextWrapped("3D, sprites and text are drawn again on your GPU at "
+                         "a higher resolution.  Movies stay native.");
+    changed |= ImGui::Checkbox("Smooth picture (bilinear)", &settings_.smooth);
+  }
+  if (ImGui::CollapsingHeader("Audio", ImGuiTreeNodeFlags_DefaultOpen)) {
+    changed |= ImGui::SliderInt("Volume", &settings_.volume, 0, 100, "%d%%");
+  }
+  if (!settings_.cheats.empty() &&
+      ImGui::CollapsingHeader("Extras", ImGuiTreeNodeFlags_DefaultOpen)) {
+    for (Cheat &c : settings_.cheats)
+      changed |= ImGui::Checkbox(c.name.c_str(), &c.enabled);
+  }
+  if (ImGui::CollapsingHeader("Controls")) {
+    changed |= ImGui::Checkbox("Analog controller (DualShock)", &settings_.analog);
+    ImGui::TextWrapped("On: twin-stick -- the left stick moves the player, the right "
+                       "stick aims and fires (the game's DualShock mode; the "
+                       "left stick still works the menus).  Off: a digital "
+                       "pad, as on an original PlayStation controller.");
+    ImGui::TextWrapped(
+        "Controller (by position): A/Cross  B/Circle  X/Square  Y/Triangle, "
+        "bumpers L1/R1, triggers L2/R2, left stick or D-pad to move, right "
+        "stick to aim and fire (analog on), "
+        "Back = Select, Start = Start.\n"
+        "Keyboard: arrows move, Z/X/A/S = Cross/Circle/Square/Triangle, "
+        "Q/W/E/R = L1/R1/L2/R2, Enter = Start.");
+  }
+
+  ImGui::Separator();
+  if (ImGui::Button("Resume"))
+    setOpen(false);
+  ImGui::SameLine();
+  if (ImGui::Button("Original settings")) {
+    settings_.aspect = 0;
+    settings_.smooth = false;
+    settings_.analog = false;
+    settings_.resolution = 0;
+    for (Cheat &c : settings_.cheats)
+      c.enabled = false;
+    changed = true;
+  }
+  ImGui::SameLine();
+  if (!confirmQuit_) {
+    if (ImGui::Button("Quit game"))
+      confirmQuit_ = true;
+  } else {
+    if (ImGui::Button("Really quit?"))
+      quit_ = true;
+    ImGui::SameLine();
+    if (ImGui::Button("No"))
+      confirmQuit_ = false;
+  }
+  ImGui::End();
+
+  ImGui::Render();
+  ImGui_ImplOpenGL3_RenderDrawData(ImGui::GetDrawData());
+
+  if (changed) {
+    if (onApply)
+      onApply(settings_);
+    save();
+  }
+}
+
+void Overlay::load() {
+  std::ifstream in(iniPath_);
+  std::string line;
+  while (std::getline(in, line)) {
+    const size_t eq = line.find('=');
+    if (eq == std::string::npos || line[0] == '#' || line[0] == ';')
+      continue;
+    const std::string key = line.substr(0, eq), val = line.substr(eq + 1);
+    const int n = std::atoi(val.c_str());
+    if (key == "fullscreen") settings_.fullscreen = n != 0;
+    else if (key == "aspect") settings_.aspect = (n >= 0 && n <= 3) ? n : 0;
+    else if (key == "smooth") settings_.smooth = n != 0;
+    else if (key == "volume") settings_.volume = std::clamp(n, 0, 100);
+    else if (key == "disc") settings_.disc = val;
+    else if (key == "analog") settings_.analog = n != 0;
+    else if (key == "resolution") settings_.resolution = (n >= 0 && n <= 6) ? n : 6;
+    else if (key.rfind("cheat.", 0) == 0)
+      for (Cheat &c : settings_.cheats)
+        if (c.name == key.substr(6))
+          c.enabled = n != 0;
+  }
+  if (onApply)
+    onApply(settings_);
+}
+
+void Overlay::save() const {
+  std::ofstream out(iniPath_, std::ios::trunc);
+  if (!out)
+    return;
+  out << "# Written by the overlay menu (F1).\n"
+      << "fullscreen=" << settings_.fullscreen << "\n"
+      << "aspect=" << settings_.aspect << "\n"
+      << "smooth=" << settings_.smooth << "\n"
+      << "analog=" << settings_.analog << "\n"
+      << "resolution=" << settings_.resolution << "\n"
+      << "volume=" << settings_.volume << "\n";
+  if (!settings_.disc.empty())
+    out << "disc=" << settings_.disc << "\n";
+  for (const Cheat &c : settings_.cheats)
+    out << "cheat." << c.name << "=" << c.enabled << "\n";
+}
+
+} // namespace ps1::overlay
