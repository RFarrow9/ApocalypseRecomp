+// Reporter for the callee-saved register check (PS1_ABI_CALL, see
+// ps1_runtime_macros.h), and the call profiler that rides on the same hook.
+// Built only with -DPS1RECOMP_ABI_CHECK=ON; ps1CallProfileDump is a no-op
+// otherwise so main_host can call it unconditionally.
+#include <cstdint>
+
+#ifdef PS1_ABI_CHECK
+#include "runtime/ps1_runtime_macros.h"
