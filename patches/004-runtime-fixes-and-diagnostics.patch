new file mode 100644
index 0000000..8196cb8
--- /dev/null
+++ b/ps1Runtime/src/cdrom/xa_decoder.cpp
@@ -0,0 +1,107 @@
+#include "runtime/cdrom/xa_decoder.h"
+
+#include <algorithm>
+
+namespace ps1::cdrom {
+
+namespace {
+constexpr int kPos[4] = {0, 60, 115, 98};
+constexpr int kNeg[4] = {0, 0, -52, -55};
+constexpr uint32_t kOutRate = 44100;
+
+int16_t clamp16(int32_t v) {
+  return static_cast<int16_t>(std::clamp(v, -32768, 32767));
+}
+} // namespace
+
+bool XaDecoder::isAudioSector(const uint8_t *raw) {
+  const uint8_t submode = raw[18];
+  return (submode & 0x04) && (submode & 0x20);
+}
+
+void XaDecoder::reset() {
+  old_[0] = old_[1] = older_[0] = older_[1] = 0;
+  phase_ = 0.0;
+  lastL_ = lastR_ = 0;
+}
+
+// One 128-byte sound group: 16 header bytes (unit parameters at 4..11, the
+// same values mirrored at 0..3 and 12..15), then 28 words of sample data.
+void XaDecoder::decodeGroup(const uint8_t *group, bool stereo, bool eightBit,
+                            std::vector<int16_t> &left,
+                            std::vector<int16_t> &right) {
+  const int units = eightBit ? 4 : 8;
+  for (int u = 0; u < units; ++u) {
+    const uint8_t param = group[4 + u];
+    const int shift = param & 0x0F;
+    const int filter = (param >> 4) & 0x03;
+    const int ch = stereo ? (u & 1) : 0;
+    std::vector<int16_t> &dst = (stereo && (u & 1)) ? right : left;
+    for (int j = 0; j < 28; ++j) {
+      int32_t s;
+      if (eightBit) {
+        s = static_cast<int8_t>(group[16 + j * 4 + u]) << 8;
+      } else {
+        const uint8_t b = group[16 + j * 4 + (u >> 1)];
+        const int nib = (u & 1) ? (b >> 4) : (b & 0x0F);
+        s = static_cast<int16_t>(nib << 12);
+      }
+      s >>= (shift > 12 ? 9 : shift);
+      s += (old_[ch] * kPos[filter] + older_[ch] * kNeg[filter] + 32) >> 6;
+      const int16_t out = clamp16(s);
+      older_[ch] = old_[ch];
+      old_[ch] = out;
+      dst.push_back(out);
+    }
+  }
+}
+
+// Linear interpolation from srcRate to 44.1 kHz, continuous across calls.
+void XaDecoder::resampleInto(const std::vector<int16_t> &left,
+                             const std::vector<int16_t> &right,
+                             uint32_t srcRate, std::vector<int16_t> &out) {
+  const double step = static_cast<double>(srcRate) / kOutRate;
+  const size_t n = left.size();
+  // Positions index [previous sector's last frame, this sector's frames...]:
+  // index 0 is the carried-over frame, 1..n are this sector's.
+  auto at = [&](size_t k, bool r) -> double {
+    if (k == 0)
+      return r ? lastR_ : lastL_;
+    return r ? right[k - 1] : left[k - 1];
+  };
+  for (;;) {
+    const size_t k = static_cast<size_t>(phase_);
+    if (k + 1 > n)
+      break;
+    const double f = phase_ - static_cast<double>(k);
+    out.push_back(clamp16(static_cast<int32_t>(at(k, false) * (1.0 - f) +
+                                               at(k + 1, false) * f)));
+    out.push_back(clamp16(static_cast<int32_t>(at(k, true) * (1.0 - f) +
+                                               at(k + 1, true) * f)));
+    phase_ += step;
+  }
+  phase_ -= static_cast<double>(n);
+  if (n) {
+    lastL_ = left[n - 1];
+    lastR_ = right[n - 1];
+  }
+}
+
+void XaDecoder::decodeSector(const uint8_t *raw, std::vector<int16_t> &out) {
+  const uint8_t coding = raw[19];
+  const bool stereo = (coding & 0x03) == 1;
+  const uint32_t rate = ((coding >> 2) & 0x03) == 1 ? 18900 : 37800;
+  const bool eightBit = ((coding >> 4) & 0x03) == 1;
+
+  std::vector<int16_t> left, right;
+  left.reserve(4032);
+  right.reserve(2016);
+  const uint8_t *data = raw + 24; // after sync, header and subheader
+  for (int g = 0; g < 18; ++g)
+    decodeGroup(data + g * 128, stereo, eightBit, left, right);
+  if (!stereo)
+    right = left;
+  resampleInto(left, right, rate, out);
+}
+
+} // namespace ps1::cdrom
