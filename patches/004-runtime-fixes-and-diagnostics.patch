diff --git a/ps1Runtime/include/runtime/overlay.h b/ps1Runtime/include/runtime/overlay.h
new file mode 100644
index 0000000..f8b4572
--- /dev/null
+++ b/ps1Runtime/include/runtime/overlay.h
@@ -0,0 +1,107 @@
+#pragma once
+// In-game overlay menu (Dear ImGui): display and audio settings, per-game
+// cheats, quit.  Opened with F1 or Esc, or Back+Start on a controller; the
+// game is paused while it is open.  Settings persist in an INI file.
+
+#include <cstdint>
+#include <functional>
+#include <string>
+#include <vector>
+
+union SDL_Event;
+struct SDL_Window;
+
+namespace ps1::overlay {
+
+// One cheat action, parsed from the game config:
+//   "800FF9B8=1"             write 1 (32-bit) to 0x800FF9B8
+//   "800FFC28>DA=64:h"       follow the pointer at 0x800FFC28, +0xDA, write
+//                            0x64 as 16 bits (:b = 8 bits)
+//   "call 8005E62C 800FFC28>0 3 unless 800FFC28>270"
+//                            call the guest function 0x8005E62C(a0, a1) with
+//                            a0 = the pointer at 0x800FFC28 and a1 = 3,
+//                            unless the word at *0x800FFC28+0x270 is nonzero
+// Any action may end with " if <chain>=<hex>": it runs only while the word
+// there has that value (e.g. the object's class pointer, so a player cheat
+// never writes into whatever the pointer holds between levels).
+// A chain "A>o1>o2" means: start at A, then for each ">o" read the word
+// there and add o.  Any null or non-RAM pointer skips the action.
+struct CheatAction {
+  bool isCall = false;
+  std::vector<uint32_t> target; // chain: poke address / call a0
+  uint32_t value = 0;           // poke value / call a1
+  int width = 4;                // poke width in bytes
+  uint32_t func = 0;
+  std::vector<uint32_t> unless; // call guard chain (empty: none)
+  std::vector<uint32_t> when;   // "if" chain (empty: always)
+  uint32_t whenValue = 0;
+};
+
+struct Cheat {
+  std::string name;
+  std::vector<CheatAction> actions;
+  bool enabled = false;
+};
+
+// Host access the cheats need: RAM and a way to call guest code.
+struct CheatHost {
+  std::function<uint32_t(uint32_t)> read32;
+  std::function<void(uint32_t, uint32_t, int)> write; // addr, value, width
+  std::function<void(uint32_t, uint32_t, uint32_t)> call; // func, a0, a1
+};
+
+struct Settings {
+  bool fullscreen = false;
+  int aspect = 0;      // 0 = 4:3 (original), 1 = 16:9, 2 = 21:9, 3 = 32:9
+  bool smooth = false; // bilinear filtering of the final picture
+  int resolution = 6;  // index into kResolutions (overlay.cpp); 6 = auto
+  int volume = 100;    // percent
+  bool analog = true;  // report a DualShock in analog mode (sticks reach the game)
+  std::string disc;    // disc image chosen at first run (kept, not shown)
+  std::vector<Cheat> cheats;
+};
+
+class Overlay {
+public:
+  // `glContext` is the SDL_GLContext the renderer created.
+  bool init(SDL_Window *window, void *glContext, const std::string &iniPath);
+  void shutdown();
+
+  // Adds a cheat defined by the game config (see CheatAction for syntax).
+  void addCheat(const std::string &name, const std::vector<std::string> &pokes);
+
+  // Applies every enabled cheat; call once per frame while the game runs.
+  void applyCheats(const CheatHost &host);
+
+  // Feed every SDL event.  Returns true when the overlay consumed it (the
+  // game must not see it): all input while open, and the open/close chord.
+  bool handleEvent(const SDL_Event &e);
+
+  // Draw inside the current GL frame, after the game picture.
+  void draw();
+
+  bool isOpen() const { return open_; }
+  bool quitRequested() const { return quit_; }
+  const Settings &settings() const { return settings_; }
+  Settings &settings() { return settings_; }
+
+  // Called whenever a setting changes (and once after load) so the host
+  // applies it: window mode, aspect, filtering, volume.
+  std::function<void(const Settings &)> onApply;
+
+  void load();
+  void save() const;
+
+private:
+  void setOpen(bool open);
+
+  SDL_Window *window_ = nullptr;
+  std::string iniPath_;
+  Settings settings_;
+  bool ready_ = false;
+  bool open_ = false;
+  bool quit_ = false;
+  bool confirmQuit_ = false;
+};
+
+} // namespace ps1::overlay
