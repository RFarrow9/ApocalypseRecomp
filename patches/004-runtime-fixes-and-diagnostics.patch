   EXPECT_NE(stat & (1 << 22), 0); // Interlace
 }
+
+// GP1(08h) bit 6 (368-pixel mode) belongs in GPUSTAT bit 16, not bit 23
+// (display disable).
+TEST_F(GpuDisplayTest, DisplayModeBit6IsHres2) {
+  gpu.writeGP1(0x03000000); // display on
+  gpu.writeGP1(0x08000000 | (1 << 6));
+  const uint32_t stat = gpu.readGPUSTAT();
+  EXPECT_NE(stat & (1u << 16), 0u);
+  EXPECT_EQ(stat & (1u << 23), 0u);
+}
+
+// In 24bpp the displayed pixels pack three bytes across halfwords.
+TEST_F(GpuDisplayTest, ComposeDisplay24bpp) {
+  gpu.writeGP1(0x08000000 | 1 | (1 << 4)); // 320 wide, 24bpp
+  gpu.writeGP1(0x05000000);                // display area (0,0)
+  gpu.writeGP1(0x07000000 | (16 << 10) | 0); // 16 lines
+  auto *vram = const_cast<Color16 *>(gpu.getVRAM());
+  vram[0].raw = 0x2211; // pixel 0 = R 11, G 22
+  vram[1].raw = 0x4433; //           B 33; pixel 1 = R 44
+  vram[2].raw = 0x6655; //           G 55, B 66
+  gpu.snapshotDisplayBuffer();
+  std::vector<uint32_t> rgba;
+  int w = 0, h = 0;
+  gpu.composeDisplay(rgba, w, h);
+  ASSERT_EQ(w, 320);
+  ASSERT_EQ(h, 16);
+  EXPECT_EQ(rgba[0], 0xFF332211u);
+  EXPECT_EQ(rgba[1], 0xFF665544u);
+}
diff --git a/ps1Test/runtime/test_gpu_rasterizer.cpp b/ps1Test/runtime/test_gpu_rasterizer.cpp
index 5ef3507..3af3350 100644
--- a/ps1Test/runtime/test_gpu_rasterizer.cpp
+++ b/ps1Test/runtime/test_gpu_rasterizer.cpp
@@ -66,3 +66,29 @@ TEST_F(GpuRasterizerTest, MonochromeQuadDrawsTwoTriangles) {
   // Outside
   EXPECT_EQ(vram[9 * GPU::VRAM_WIDTH + 10].raw, 0);
 }
+
+// The GPU drops any triangle wider than 1023 or taller than 511 pixels.
+// Games rely on it for polygons with a vertex behind the camera.
+TEST_F(GpuRasterizerTest, OversizedTriangleIsSkipped) {
+  gpu.writeGP0(0x2000FF00);
+  gpu.writeGP0((10 << 16) | 10);
+  gpu.writeGP0((10 << 16) | 1000); // 990 wide: still drawn
+  gpu.writeGP0((20 << 16) | 10);
+  EXPECT_NE(gpu.getVRAM()[11 * GPU::VRAM_WIDTH + 11].raw, 0);
+
+  gpu.reset();
+  gpu.writeGP0(0x2000FF00);
+  gpu.writeGP0((10 << 16) | static_cast<uint16_t>(-100 & 0x7FF)); // x = -100
+  gpu.writeGP0((10 << 16) | 1000); // 1100 wide: skipped
+  gpu.writeGP0((20 << 16) | 10);
+  EXPECT_EQ(gpu.getVRAM()[11 * GPU::VRAM_WIDTH + 11].raw, 0);
+}
+
+// Vertex coordinates are signed 11-bit; the upper bits are ignored.
+TEST_F(GpuRasterizerTest, VertexCoordinatesAreElevenBit) {
+  gpu.writeGP0(0x2000FF00);
+  gpu.writeGP0((10 << 16) | (0xF800 | 10)); // upper bits set: still x = 10
+  gpu.writeGP0((10 << 16) | 20);
+  gpu.writeGP0((20 << 16) | 10);
+  EXPECT_NE(gpu.getVRAM()[11 * GPU::VRAM_WIDTH + 11].raw, 0);
+}
