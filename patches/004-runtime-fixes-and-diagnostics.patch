+// The picture a TV would show, from the VBlank snapshot: the display area at
+// GP1(05h), sized by the display mode, 15bpp or 24bpp (GPUSTAT bit 21).
+void GPU::composeDisplay(std::vector<uint32_t> &rgba, int &w, int &h) const {
+  std::lock_guard<std::mutex> lock(displayMutex_);
+  const uint32_t stat = gpuStat_;
+  w = 320;
+  h = 240;
+  if (displayModeSet_) {
+    static const int kWidths[4] = {256, 320, 512, 640};
+    w = (stat & (1u << 16)) ? 368 : kWidths[(stat >> 17) & 3];
+    // GP1(07h) gives the scanline count; 480-line mode doubles it.
+    int lines = static_cast<int>(displayY2_) - static_cast<int>(displayY1_);
+    if (lines <= 0 || lines > 288)
+      lines = 240;
+    const bool interlaced480 = (stat & (1u << 19)) && (stat & (1u << 22));
+    h = interlaced480 ? lines * 2 : lines;
+  }
+  const bool depth24 = (stat >> 21) & 1;
+  rgba.assign(static_cast<size_t>(w) * h, 0xFF000000u);
+  const uint32_t x0 = displayVRAMXStart_, y0 = displayVRAMYStart_;
+  const uint16_t *vram = reinterpret_cast<const uint16_t *>(displayVram_.data());
+  for (int y = 0; y < h; y++) {
+    const uint16_t *row = vram + ((y0 + y) & (VRAM_HEIGHT - 1)) * VRAM_WIDTH;
+    uint32_t *out = rgba.data() + static_cast<size_t>(y) * w;
+    for (int x = 0; x < w; x++) {
+      uint32_t r, g, b;
+      if (depth24) {
+        // Three bytes per pixel, packed across halfwords.
+        const uint32_t byte = x * 3;
+        auto at = [&](uint32_t i) -> uint32_t {
+          const uint16_t hw = row[(x0 + i / 2) & (VRAM_WIDTH - 1)];
+          return (i & 1) ? (hw >> 8) : (hw & 0xFF);
+        };
+        r = at(byte);
+        g = at(byte + 1);
+        b = at(byte + 2);
+      } else {
+        const uint16_t p = row[(x0 + x) & (VRAM_WIDTH - 1)];
+        r = (p & 0x1F) << 3;
+        g = ((p >> 5) & 0x1F) << 3;
+        b = ((p >> 10) & 0x1F) << 3;
+        r |= r >> 5;
+        g |= g >> 5;
+        b |= b >> 5;
+      }
+      out[x] = 0xFF000000u | (b << 16) | (g << 8) | r;
+    }
+  }
+}
