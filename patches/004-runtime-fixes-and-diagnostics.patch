diff --git a/ps1Test/runtime/test_card_fs.cpp b/ps1Test/runtime/test_card_fs.cpp
new file mode 100644
index 0000000..b764881
--- /dev/null
+++ b/ps1Test/runtime/test_card_fs.cpp
@@ -0,0 +1,65 @@
+#include "runtime/bios/card_fs.h"
+#include "runtime/input/input.h"
+#include "runtime/memory.h"
+#include <gtest/gtest.h>
+
+using namespace ps1;
+using namespace ps1::bios;
+
+class CardFsTest : public ::testing::Test {
+protected:
+  Memory mem;
+  input::MemoryCard card0, card1;
+  CardFs fs;
+  void SetUp() override { fs.setCards(&card0, &card1); }
+};
+
+// The save path Apocalypse takes: create "bu00:NAME" with a block count in
+// the flags, reopen for writing, write; later read it back.
+TEST_F(CardFsTest, CreateWriteReadBack) {
+  EXPECT_LT(fs.open("bu00:BESLES-00460APC", 1), 0); // not there yet
+  const int h = fs.open("bu00:BESLES-00460APC", 0x10200); // create, 1 block
+  ASSERT_GE(h, 0);
+  EXPECT_EQ(fs.close(h), 0);
+  EXPECT_LT(fs.open("bu00:BESLES-00460APC", 0x10200), 0); // exists: refused
+
+  const uint32_t src = 0x80010000, dst = 0x80020000;
+  for (uint32_t i = 0; i < 256; i++)
+    mem.write8(src + i, static_cast<uint8_t>(i * 7));
+  const int w = fs.open("bu00:BESLES-00460APC", 2);
+  ASSERT_GE(w, 0);
+  EXPECT_EQ(fs.write(w, mem, src, 256), 256);
+  fs.close(w);
+
+  const int r = fs.open("bu00:BESLES-00460APC", 1);
+  ASSERT_GE(r, 0);
+  EXPECT_EQ(fs.read(r, mem, dst, 256), 256);
+  for (uint32_t i = 0; i < 256; i++)
+    ASSERT_EQ(mem.read8(dst + i), static_cast<uint8_t>(i * 7)) << i;
+
+  // On-card format (psx-spx): directory frame 1 = first block, 8 KB, named;
+  // data in block 1 at 0x2000.
+  const auto &img = card0.image();
+  EXPECT_EQ(img[128], 0x51);
+  EXPECT_EQ(img[128 + 4] | (img[128 + 5] << 8), 0x2000);
+  EXPECT_STREQ(reinterpret_cast<const char *>(&img[128 + 0x0A]),
+               "BESLES-00460APC");
+  EXPECT_EQ(img[0x2000 + 1], 7);
+}
+
+TEST_F(CardFsTest, FirstFileNextFileAndErase) {
+  fs.close(fs.open("bu00:BESLES-00460APC", 0x10200));
+  fs.close(fs.open("bu00:BESLES-00460XYZ", 0x20200)); // 2 blocks
+  const uint32_t ent = 0x80030000;
+  ASSERT_TRUE(fs.firstFile("bu00:BESLES-00460*", mem, ent));
+  EXPECT_EQ(mem.read8(ent), 'B');
+  EXPECT_EQ(mem.read32(ent + 0x18), 0x2000u);
+  ASSERT_TRUE(fs.nextFile(mem, ent));
+  EXPECT_EQ(mem.read32(ent + 0x18), 0x4000u);
+  EXPECT_FALSE(fs.nextFile(mem, ent));
+
+  EXPECT_TRUE(fs.erase("bu00:BESLES-00460APC"));
+  ASSERT_TRUE(fs.firstFile("bu00:*", mem, ent));
+  EXPECT_EQ(mem.read32(ent + 0x18), 0x4000u); // only the 2-block file left
+  EXPECT_FALSE(fs.firstFile("bu10:*", mem, ent)); // other card is empty
+}
