diff --git a/ps1Runtime/src/bios/card_fs.cpp b/ps1Runtime/src/bios/card_fs.cpp
new file mode 100644
index 0000000..21035de
--- /dev/null
+++ b/ps1Runtime/src/bios/card_fs.cpp
@@ -0,0 +1,251 @@
+#include "runtime/bios/card_fs.h"
+
+#include <cstring>
+#include <fmt/format.h>
+
+namespace ps1::bios {
+
+namespace {
+constexpr uint32_t kBlockSize = 0x2000;
+constexpr uint32_t kFrame = 128;
+constexpr uint8_t kFirst = 0x51, kMiddle = 0x52, kLast = 0x53, kFree = 0xA0;
+constexpr uint32_t kCreate = 0x200;
+
+uint16_t rd16(const uint8_t *p) { return static_cast<uint16_t>(p[0] | (p[1] << 8)); }
+uint32_t rd32(const uint8_t *p) {
+  return p[0] | (p[1] << 8) | (p[2] << 16) | (static_cast<uint32_t>(p[3]) << 24);
+}
+void wr16(uint8_t *p, uint16_t v) {
+  p[0] = static_cast<uint8_t>(v);
+  p[1] = static_cast<uint8_t>(v >> 8);
+}
+void wr32(uint8_t *p, uint32_t v) {
+  for (int i = 0; i < 4; i++)
+    p[i] = static_cast<uint8_t>(v >> (8 * i));
+}
+} // namespace
+
+bool CardFs::split(const std::string &path, int &card, std::string &name) {
+  if (path.size() < 5 || path.compare(0, 2, "bu") != 0 || path[4] != ':')
+    return false;
+  card = (path[2] == '1') ? 1 : 0;
+  name = path.substr(5);
+  return true;
+}
+
+bool CardFs::isCardPath(const std::string &path) {
+  int card;
+  std::string name;
+  return split(path, card, name);
+}
+
+uint8_t *CardFs::frame(int card, int index) {
+  return cards_[card]->image().data() + index * kFrame;
+}
+
+void CardFs::seal(int card, int index) {
+  uint8_t *f = frame(card, index);
+  uint8_t x = 0;
+  for (uint32_t i = 0; i < kFrame - 1; i++)
+    x ^= f[i];
+  f[kFrame - 1] = x;
+}
+
+int CardFs::findFile(int card, const std::string &name) {
+  for (int b = 1; b <= 15; b++) {
+    const uint8_t *d = frame(card, b);
+    if (d[0] == kFirst &&
+        std::strncmp(reinterpret_cast<const char *>(d + 0x0A), name.c_str(), 20) == 0)
+      return b;
+  }
+  return -1;
+}
+
+int CardFs::createFile(int card, const std::string &name, int blocks) {
+  if (blocks < 1)
+    blocks = 1;
+  int chain[15], n = 0;
+  for (int b = 1; b <= 15 && n < blocks; b++)
+    if ((frame(card, b)[0] & 0xF0) == kFree)
+      chain[n++] = b;
+  if (n < blocks)
+    return -1; // card full
+  for (int i = 0; i < n; i++) {
+    uint8_t *d = frame(card, chain[i]);
+    std::memset(d, 0, kFrame);
+    wr32(d, (i == 0) ? kFirst : (i == n - 1) ? kLast : kMiddle);
+    if (i == 0) {
+      wr32(d + 4, static_cast<uint32_t>(n) * kBlockSize);
+      std::strncpy(reinterpret_cast<char *>(d + 0x0A), name.c_str(), 20);
+    }
+    wr16(d + 8, (i + 1 < n) ? static_cast<uint16_t>(chain[i + 1] - 1) : 0xFFFF);
+    seal(card, chain[i]);
+    std::memset(cards_[card]->image().data() + chain[i] * kBlockSize, 0, kBlockSize);
+  }
+  cards_[card]->commit();
+  return chain[0];
+}
+
+int CardFs::open(const std::string &path, uint32_t flags) {
+  int card;
+  std::string name;
+  if (!split(path, card, name) || !cards_[card] || !cards_[card]->isPresent())
+    return -1;
+  int first = findFile(card, name);
+  if (flags & kCreate) {
+    if (first >= 0)
+      return -1; // the BIOS refuses to create over an existing file
+    first = createFile(card, name, static_cast<int>(flags >> 16));
+  }
+  if (first < 0)
+    return -1;
+  for (int h = 0; h < 8; h++) {
+    if (handles_[h].used)
+      continue;
+    handles_[h] = Handle{true, card, first, rd32(frame(card, first) + 4), 0};
+    fmt::print("[CARD] open('{}', 0x{:X}) -> block {}, {} bytes\n", path, flags,
+               first, handles_[h].size);
+    return h;
+  }
+  return -1;
+}
+
+int CardFs::close(int h) {
+  if (h < 0 || h >= 8 || !handles_[h].used)
+    return -1;
+  handles_[h].used = false;
+  return 0;
+}
+
+int CardFs::locate(const Handle &h, uint32_t pos) {
+  if (pos >= h.size)
+    return -1;
+  int block = h.firstBlock;
+  for (uint32_t skip = pos / kBlockSize; skip > 0; skip--) {
+    const uint16_t next = rd16(frame(h.card, block) + 8);
+    if (next == 0xFFFF)
+      return -1;
+    block = next + 1;
+  }
+  return static_cast<int>(block * kBlockSize + pos % kBlockSize);
+}
+
+int CardFs::read(int hi, Memory &mem, uint32_t dst, int len) {
+  if (hi < 0 || hi >= 8 || !handles_[hi].used)
+    return -1;
+  Handle &h = handles_[hi];
+  const uint8_t *img = cards_[h.card]->image().data();
+  int done = 0;
+  for (; done < len; done++) {
+    const int at = locate(h, h.pos);
+    if (at < 0)
+      break;
+    mem.write8(dst + done, img[at]);
+    h.pos++;
+  }
+  return done;
+}
+
+int CardFs::write(int hi, Memory &mem, uint32_t src, int len) {
+  if (hi < 0 || hi >= 8 || !handles_[hi].used)
+    return -1;
+  Handle &h = handles_[hi];
+  uint8_t *img = cards_[h.card]->image().data();
+  int done = 0;
+  for (; done < len; done++) {
+    const int at = locate(h, h.pos);
+    if (at < 0)
+      break;
+    img[at] = mem.read8(src + done);
+    h.pos++;
+  }
+  cards_[h.card]->commit();
+  fmt::print("[CARD] write {} bytes at {}\n", done, h.pos - done);
+  return done;
+}
+
+int CardFs::lseek(int hi, int offset, int whence) {
+  if (hi < 0 || hi >= 8 || !handles_[hi].used)
+    return -1;
+  Handle &h = handles_[hi];
+  int64_t p = (whence == 0) ? offset
+              : (whence == 1) ? static_cast<int64_t>(h.pos) + offset
+                              : static_cast<int64_t>(h.size) + offset;
+  if (p < 0 || p > h.size)
+    return -1;
+  h.pos = static_cast<uint32_t>(p);
+  return static_cast<int>(h.pos);
+}
+
+bool CardFs::erase(const std::string &path) {
+  int card;
+  std::string name;
+  if (!split(path, card, name) || !cards_[card])
+    return false;
+  int block = findFile(card, name);
+  if (block < 0)
+    return false;
+  // Deleted entries keep their chain: 51/52/53 become A1/A2/A3.
+  while (block > 0 && block <= 15) {
+    uint8_t *d = frame(card, block);
+    d[0] = static_cast<uint8_t>(0xA0 | (d[0] & 0x0F));
+    const uint16_t next = rd16(d + 8);
+    seal(card, block);
+    block = (next == 0xFFFF) ? -1 : next + 1;
+  }
+  cards_[card]->commit();
+  return true;
+}
+
+bool CardFs::matches(const std::string &pattern, const std::string &name) {
+  size_t i = 0;
+  for (; i < pattern.size(); i++) {
+    if (pattern[i] == '*')
+      return true;
+    if (i >= name.size() || (pattern[i] != '?' && pattern[i] != name[i]))
+      return false;
+  }
+  return i == name.size();
+}
+
+bool CardFs::findFrom(int card, int block, Memory &mem, uint32_t dst) {
+  for (int b = block; b <= 15; b++) {
+    const uint8_t *d = frame(card, b);
+    if (d[0] != kFirst)
+      continue;
+    const std::string name(reinterpret_cast<const char *>(d + 0x0A),
+                           strnlen(reinterpret_cast<const char *>(d + 0x0A), 20));
+    if (!matches(enumPattern_, name))
+      continue;
+    // DIRENTRY: name[20], attr, size, next, head (first sector), system[4]
+    for (uint32_t i = 0; i < 0x28; i++)
+      mem.write8(dst + i, 0);
+    for (size_t i = 0; i < name.size(); i++)
+      mem.write8(dst + static_cast<uint32_t>(i), static_cast<uint8_t>(name[i]));
+    mem.write32(dst + 0x14, 0x50);
+    mem.write32(dst + 0x18, rd32(d + 4));
+    mem.write32(dst + 0x20, static_cast<uint32_t>(b) * (kBlockSize / kFrame));
+    enumNext_ = b + 1;
+    return true;
+  }
+  enumNext_ = 16;
+  return false;
+}
+
+bool CardFs::firstFile(const std::string &pattern, Memory &mem, uint32_t dst) {
+  int card;
+  std::string name;
+  if (!split(pattern, card, name) || !cards_[card])
+    return false;
+  enumCard_ = card;
+  enumPattern_ = name.empty() ? "*" : name;
+  return findFrom(card, 1, mem, dst);
+}
+
+bool CardFs::nextFile(Memory &mem, uint32_t dst) {
+  if (!cards_[enumCard_])
+    return false;
+  return findFrom(enumCard_, enumNext_, mem, dst);
+}
+
+} // namespace ps1::bios
