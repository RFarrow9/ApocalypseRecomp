+
+std::string utf8(const fs::path &p) {
+  const auto u = p.u8string();
+  return std::string(u.begin(), u.end());
+}
+
+fs::path fromUtf8(const std::string &s) {
+  return fs::path(std::u8string(s.begin(), s.end()));
+}
+
+std::string upper(std::string s) {
+  for (char &c : s)
+    c = static_cast<char>(std::toupper(static_cast<unsigned char>(c)));
+  return s;
+}
+
+std::string readIniDisc(const fs::path &ini) {
+  std::ifstream in(ini);
+  std::string line;
+  while (std::getline(in, line))
+    if (line.rfind("disc=", 0) == 0)
+      return line.substr(5);
+  return {};
+}
+
+// Replace (or add) the `disc=` line, keeping every other setting.
+void writeIniDisc(const fs::path &ini, const std::string &disc) {
+  std::vector<std::string> lines;
+  {
+    std::ifstream in(ini);
+    std::string line;
+    while (std::getline(in, line))
+      if (line.rfind("disc=", 0) != 0)
+        lines.push_back(line);
+  }
+  lines.push_back("disc=" + disc);
+  std::ofstream out(ini, std::ios::trunc);
+  for (const auto &l : lines)
+    out << l << "\n";
+}
+
+std::optional<fs::path> askForDisc(const std::string &gameName) {
+#ifdef _WIN32
+  wchar_t file[MAX_PATH * 4] = L"";
+  const std::wstring title =
+      fs::path(std::u8string(gameName.begin(), gameName.end())).wstring() +
+      L": select your disc image (.cue)";
+  OPENFILENAMEW ofn{};
+  ofn.lStructSize = sizeof(ofn);
+  ofn.lpstrFilter = L"PlayStation disc image (*.cue)\0*.cue\0All files\0*.*\0";
+  ofn.lpstrFile = file;
+  ofn.nMaxFile = static_cast<DWORD>(std::size(file));
+  ofn.lpstrTitle = title.c_str();
+  ofn.Flags = OFN_FILEMUSTEXIST | OFN_PATHMUSTEXIST | OFN_NOCHANGEDIR;
+  if (GetOpenFileNameW(&ofn))
+    return fs::path(file);
+  return std::nullopt;
+#else
+  (void)gameName;
+  return std::nullopt;
+#endif
+}
+
+void tell(const std::string &title, const std::string &msg) {
+  fmt::print(stderr, "[Disc] {}\n", msg);
+  SDL_ShowSimpleMessageBox(SDL_MESSAGEBOX_INFORMATION, title.c_str(),
+                           msg.c_str(), nullptr);
+}
+
+} // namespace
+
+std::optional<std::string> extractBootExe(const fs::path &cue,
+                                          const fs::path &cacheDir,
+                                          std::string *bootName) {
+  const auto tracks = cdrom::CueParser::parse(cue);
+  if (!tracks)
+    return std::nullopt;
+  const auto data = std::find_if(tracks->begin(), tracks->end(), [](const auto &t) {
+    return t.type == cdrom::TrackType::Data;
+  });
+  if (data == tracks->end())
+    return std::nullopt;
+  cdrom::BinReader reader;
+  if (!reader.open(cue.parent_path() / fromUtf8(data->file)))
+    return std::nullopt;
+  cdrom::Iso9660Parser iso(reader);
+  if (!iso.initialize())
+    return std::nullopt;
+  cdrom::ExeExtractor extractor(reader, iso);
+  const auto bootPath = extractor.getBootExecutablePath();
+  const auto bytes = extractor.extractExecutable();
+  if (!bootPath || !bytes || bytes->empty())
+    return std::nullopt;
+  // "cdrom:\SLES_004.60;1" -> "SLES_004.60"
+  std::string name = *bootPath;
+  if (const auto s = name.find_last_of("\\/:"); s != std::string::npos)
+    name = name.substr(s + 1);
+  if (const auto v = name.find(';'); v != std::string::npos)
+    name = name.substr(0, v);
+  if (bootName)
+    *bootName = name;
+  std::error_code ec;
+  fs::create_directories(cacheDir, ec);
+  const fs::path out = cacheDir / name;
+  std::ofstream f(out, std::ios::binary | std::ios::trunc);
+  f.write(reinterpret_cast<const char *>(bytes->data()),
+          static_cast<std::streamsize>(bytes->size()));
+  if (!f)
+    return std::nullopt;
+  return utf8(out);
+}
+
+std::optional<DiscPaths> resolveDisc(const fs::path &settingsIni,
+                                     const fs::path &cacheDir,
+                                     const std::string &gameName,
+                                     const std::string &expectedBoot,
+                                     const std::string &given) {
+  std::vector<fs::path> candidates;
+  if (!given.empty())
+    candidates.push_back(fromUtf8(given));
+  if (const std::string saved = readIniDisc(settingsIni); !saved.empty())
+    candidates.push_back(fromUtf8(saved));
+
+  bool asked = false;
+  for (;;) {
+    if (candidates.empty()) {
+      if (!asked)
+        tell(gameName,
+             "Welcome! This is a native PC port that runs from your own copy "
+             "of the game.\n\nNext, select the disc image (.cue file) of " +
+                 gameName + ".");
+      asked = true;
+      const auto picked = askForDisc(gameName);
+      if (!picked)
+        return std::nullopt;
+      candidates.push_back(*picked);
+    }
