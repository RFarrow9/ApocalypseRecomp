+// Display flip: the list since the last flip drew the frame now shown.
+void GPU::hiresFlip() {
+  if (!hiresCapture_.load(std::memory_order_relaxed)) {
+    hiresPrims_.clear();
+    return;
+  }
+  auto f = std::make_shared<HiResFrame>();
+  f->prims.swap(hiresPrims_);
+  f->vram.resize(vram_.size());
+  std::memcpy(f->vram.data(), vram_.data(), vram_.size() * sizeof(Color16));
+  f->x = displayVRAMXStart_;
+  f->y = displayVRAMYStart_;
+  std::lock_guard<std::mutex> lock(hiresMutex_);
+  hiresReady_ = std::move(f);
+}
+
+std::shared_ptr<HiResFrame> GPU::takeHiResFrame() {
+  std::lock_guard<std::mutex> lock(hiresMutex_);
+  return std::move(hiresReady_);
+}
