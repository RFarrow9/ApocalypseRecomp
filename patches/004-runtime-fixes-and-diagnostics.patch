+// One macroblock whose blocks carry only a DC term: chroma 0, luma `y`
+// (q_scale 1 in the top bits).  0x0600 is DC -512 (black); 0x0420 is DC 32,
+// which with qt[0] = 2 gives Y = 32*2/8 = 8, a grey of 136.
+static void feedFlatMacroblock(MDEC &mdec, uint32_t depthBits, uint16_t y) {
+  const uint16_t hw[12] = {0x0400, 0xFE00, 0x0400, 0xFE00, y, 0xFE00,
+                           y,      0xFE00, y,      0xFE00, y, 0xFE00};
+  mdec.writeCommand((1u << 29) | depthBits | 6);
+  for (int i = 0; i < 12; i += 2)
+    mdec.writeCommand(hw[i] | (uint32_t(hw[i + 1]) << 16));
+}
+
+TEST_F(MdecTest, ScaleTableUploadLeavesQuantTableAlone) {
+  // libpress DecDCTReset: quant tables (luma + chroma), then the IDCT scale
+  // table.  The scale table once landed in the quant tables.
+  mdec.writeCommand((2u << 29) | 1);
+  for (int i = 0; i < 32; i++)
+    mdec.writeCommand(0x02020202);
+  mdec.writeCommand(3u << 29);
+  for (int i = 0; i < 32; i++)
+    mdec.writeCommand(0x5A825A82);
+
+  feedFlatMacroblock(mdec, 2u << 27, 0x0420); // depth 2 = 24bpp
+  ASSERT_EQ(mdec.dmaOutRemaining(), 192u); // 16x16 pixels x 3 bytes
+  for (int i = 0; i < 192; i++)
+    ASSERT_EQ(mdec.dmaOutRead(), 0x88888888u) << "word " << i;
+}
+
+TEST_F(MdecTest, DepthFieldSelects15bpp) {
+  feedFlatMacroblock(mdec, 3u << 27, 0x0600); // depth 3 = 15bpp
+  EXPECT_EQ(mdec.dmaOutRemaining(), 128u); // 16x16 pixels x 2 bytes
+  EXPECT_EQ((mdec.readStatus() >> 25) & 3, 3u);
+}
