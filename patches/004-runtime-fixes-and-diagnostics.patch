+#include <vector>
+
+void ps1AbiReport(uint32_t target, uint32_t site, const uint32_t *before,
+                  const recomp_context *ctx) {
+  static std::mutex mtx;
+  static std::set<uint32_t> seen;
+  std::lock_guard<std::mutex> lock(mtx);
+  if (seen.size() >= 64 || !seen.insert(target).second)
+    return;
+  static const char *names[10] = {"s0", "s1", "s2", "s3", "s4",
+                                  "s5", "s6", "s7", "sp", "fp"};
+  const uint32_t after[10] = {ctx->r16, ctx->r17, ctx->r18, ctx->r19,
+                              ctx->r20, ctx->r21, ctx->r22, ctx->r23,
+                              ctx->r29, ctx->r30};
+  std::string diff;
+  for (int i = 0; i < 10; ++i)
+    if (before[i] != after[i])
+      diff += fmt::format(" {} {:08X}->{:08X}", names[i], before[i], after[i]);
+  fmt::print(stderr, "[ABI] call 0x{:08X} from 0x{:08X} clobbered:{}\n", target,
+             site, diff);
+}
+
+// Counts for calls into main RAM code, one slot per instruction address.
+namespace {
+constexpr uint32_t kProfBase = 0x80000000u;
+constexpr uint32_t kProfWords = 0x200000u / 4;
+std::atomic<uint32_t> g_callCounts[kProfWords];
+} // namespace
+
+void ps1CallCount(uint32_t target) {
+  const uint32_t off = target - kProfBase;
+  if (off < 0x200000u)
+    g_callCounts[off >> 2].fetch_add(1, std::memory_order_relaxed);
+}
+
+// Print the most-called targets since the last dump and reset the counts.
+void ps1CallProfileDump(uint32_t vsync, unsigned top) {
+  std::vector<std::pair<uint32_t, uint32_t>> hits;
+  for (uint32_t i = 0; i < kProfWords; ++i) {
+    const uint32_t n = g_callCounts[i].exchange(0, std::memory_order_relaxed);
+    if (n)
+      hits.emplace_back(n, kProfBase + i * 4);
+  }
+  std::sort(hits.rbegin(), hits.rend());
+  fmt::print(stderr, "[calls] vsync={} distinct={}\n", vsync, hits.size());
+  for (unsigned i = 0; i < hits.size() && i < top; ++i)
+    fmt::print(stderr, "[calls]   {:08X} x{}\n", hits[i].second, hits[i].first);
+}
+#else
+void ps1CallProfileDump(uint32_t, unsigned) {}
+#endif
