diff --git a/ps1Runtime/include/runtime/bios/card_fs.h b/ps1Runtime/include/runtime/bios/card_fs.h
new file mode 100644
index 0000000..720c5c7
--- /dev/null
+++ b/ps1Runtime/include/runtime/bios/card_fs.h
@@ -0,0 +1,65 @@
+#pragma once
+// The BIOS memory card filesystem ("bu00:" / "bu10:"), on the card images the
+// SIO layer already emulates.  Format per psx-spx "Memory Card Data Format":
+// frames 1..15 are the directory (one entry per 8 KB block), block n's data
+// lives at n * 0x2000.
+
+#include "runtime/input/input.h"
+#include "runtime/memory.h"
+#include <cstdint>
+#include <string>
+
+namespace ps1::bios {
+
+class CardFs {
+public:
+  void setCards(input::MemoryCard *port0, input::MemoryCard *port1) {
+    cards_[0] = port0;
+    cards_[1] = port1;
+  }
+
+  // "bu00:NAME" (port 0) or "bu10:NAME" (port 1).
+  static bool isCardPath(const std::string &path);
+
+  // BIOS open flags: 1 = read, 2 = write, 0x200 = create, size in blocks in
+  // bits 16+.  Returns a handle (>= 0) or -1.
+  int open(const std::string &path, uint32_t flags);
+  int close(int h);
+  int read(int h, Memory &mem, uint32_t dst, int len);
+  int write(int h, Memory &mem, uint32_t src, int len);
+  int lseek(int h, int offset, int whence);
+  bool erase(const std::string &path);
+
+  // firstfile/nextfile: fill a 0x28-byte DIRENTRY at `dst` for the next
+  // file matching the pattern ("*" and "?" wildcards).  False: no more.
+  bool firstFile(const std::string &pattern, Memory &mem, uint32_t dst);
+  bool nextFile(Memory &mem, uint32_t dst);
+
+private:
+  struct Handle {
+    bool used = false;
+    int card = 0;
+    int firstBlock = 0;
+    uint32_t size = 0;
+    uint32_t pos = 0;
+  };
+
+  uint8_t *frame(int card, int index);
+  void seal(int card, int index); // recompute the frame checksum
+  int findFile(int card, const std::string &name);
+  int createFile(int card, const std::string &name, int blocks);
+  // Byte offset in the card image of file byte `pos`, or -1 past the end.
+  int locate(const Handle &h, uint32_t pos);
+  bool findFrom(int card, int block, Memory &mem, uint32_t dst);
+  static bool matches(const std::string &pattern, const std::string &name);
+  static bool split(const std::string &path, int &card, std::string &name);
+
+  input::MemoryCard *cards_[2] = {nullptr, nullptr};
+  Handle handles_[8];
+  // firstfile/nextfile enumeration state
+  int enumCard_ = 0;
+  int enumNext_ = 16;
+  std::string enumPattern_;
+};
+
+} // namespace ps1::bios
