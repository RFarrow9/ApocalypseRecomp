@@ -0,0 +1,234 @@
+// Native libcd streaming (StSetRing / StSetStream / CdRead2 / StGetNext /
+// StFreeRing / StClearRing / StUnSetRing / StSetMask).
+//
+// libcd's own StCdInterrupt assembles frames from interrupt-time DMAs whose
+// correctness depends on the relative timing of sector arrival, DMA-complete
+// interrupts and the player's StGetNext/StFreeRing -- every difference in the
+// emulated timing turned into dropped sectors and a ring out of step with its
+// reader.  This implementation keeps libcd's guest-visible ring layout (32-byte
+// header slots, then 2016-byte payload slots, status halfword at the head of
+// each header) but assembles frames synchronously on each data-ready
+// interrupt and hands complete frames to StGetNext in arrival order.
+//
+// Slot status (as libcd): 0 free, 1 filling, 2 complete, 4 held by the player.
+
+#include "runtime/bios/bios.h"
+#include "runtime/cdrom/cdrom_controller.h"
+#include "runtime/ps1_runtime_macros.h"
+#include "runtime/psyq/psyq_registry.h"
+#include "runtime/psyq/psyq_st.h"
+#include <deque>
+#include <fmt/format.h>
+
+namespace ps1::psyq {
+namespace {
+
+constexpr uint32_t A0 = 4, A1 = 5, A2 = 6, A3 = 7, V0 = 2;
+constexpr uint32_t kHdr = 32;         // bytes per header slot
+constexpr uint32_t kData = 2016;      // payload bytes per sector
+constexpr uint16_t kStrMagic = 0x0160;
+
+struct StState {
+  uint32_t ringBase = 0;   // guest address of slot 0's header
+  uint32_t ringSize = 0;   // slots (sectors)
+  uint32_t startFrame = 0;
+  uint32_t endFrame = 0xFFFFFFFFu;
+  bool active = false;     // CdRead2 issued, StUnSetRing not yet
+  // Frame being assembled
+  bool filling = false;
+  uint32_t fillFrame = 0, fillStart = 0, fillCount = 0, fillNeeded = 0;
+  uint32_t writeSlot = 0;
+  std::deque<uint32_t> ready; // start slots of complete frames, in order
+  // Frames handed out: start slot -> sector count
+  std::deque<std::pair<uint32_t, uint32_t>> held;
+  uint32_t dropped = 0;
+} g;
+
+uint32_t dataBase() { return g.ringBase + g.ringSize * kHdr; }
+uint32_t hdrAddr(uint32_t slot) { return g.ringBase + slot * kHdr; }
+uint32_t dataAddr(uint32_t slot) { return dataBase() + slot * kData; }
+
+bool trace() {
+  static const bool t = std::getenv("PS1_ST_TRACE") != nullptr;
+  return t;
+}
+
+void clearRing(recomp_context *ctx) {
+  for (uint32_t i = 0; i < g.ringSize; ++i)
+    ctx->mem->write16(hdrAddr(i), 0);
+  g.filling = false;
+  g.writeSlot = 0;
+  g.ready.clear();
+  g.held.clear();
+}
+
+bool slotsFree(recomp_context *ctx, uint32_t start, uint32_t n) {
+  for (uint32_t i = 0; i < n; ++i)
+    if (ctx->mem->read16(hdrAddr(start + i)) != 0)
+      return false;
+  return true;
+}
+
+void cdCommand(recomp_context *ctx, uint8_t com, const uint8_t *params,
+               int n) {
+  auto *cdrom = ctx->bios ? ctx->bios->cdromController() : nullptr;
+  if (!cdrom)
+    return;
+  cdrom->writeRegister(0x1F801800, 0);
+  for (int i = 0; i < n; ++i)
+    cdrom->writeRegister(0x1F801802, params[i]);
+  cdrom->writeRegister(0x1F801801, com);
+}
+
+} // namespace
+
+bool st_active() { return g.active && g.ringSize != 0; }
+
+// One data sector delivered by the drive while streaming.
+void st_on_sector(recomp_context *ctx) {
+  auto *cdrom = ctx->bios ? ctx->bios->cdromController() : nullptr;
+  if (!cdrom || !cdrom->hasSectorReady())
+    return;
+  const uint8_t *raw = cdrom->getSectorBuffer();
+  const uint8_t *hdr = raw + 24; // STR header follows the subheader
+  const uint16_t magic = hdr[0] | (hdr[1] << 8);
+  const uint16_t secIdx = hdr[4] | (hdr[5] << 8);
+  const uint16_t secCnt = hdr[6] | (hdr[7] << 8);
+  const uint32_t frame =
+      hdr[8] | (hdr[9] << 8) | (hdr[10] << 16) | (static_cast<uint32_t>(hdr[11]) << 24);
+  cdrom->clearSectorReady();
+  if (magic != kStrMagic || secCnt == 0 || secCnt > g.ringSize)
+    return;
+  if (frame < g.startFrame || frame > g.endFrame)
+    return;
+
+  if (secIdx == 0) {
+    // Start a frame: contiguous slots, wrapping to 0 rather than straddling.
+    uint32_t start = g.writeSlot;
+    if (start + secCnt > g.ringSize)
+      start = 0;
+    if (!slotsFree(ctx, start, secCnt)) {
+      g.filling = false;
+      ++g.dropped;
+      if (trace())
+        fmt::print(stderr, "[ST] ring full: dropped frame {}\n", frame);
+      return;
+    }
+    g.filling = true;
+    g.fillFrame = frame;
+    g.fillStart = start;
+    g.fillCount = 0;
+    g.fillNeeded = secCnt;
+  }
+  if (!g.filling || frame != g.fillFrame || secIdx >= g.fillNeeded)
+    return;
+
+  const uint32_t slot = g.fillStart + secIdx;
+  for (uint32_t i = 0; i < kHdr; ++i)
+    ctx->mem->write8(hdrAddr(slot) + i, hdr[i]);
+  ctx->mem->write16(hdrAddr(slot), 1); // filling
+  const uint8_t *payload = hdr + kHdr;
+  for (uint32_t i = 0; i < kData; i += 4)
+    ctx->mem->write32(dataAddr(slot) + i,
+                      payload[i] | (payload[i + 1] << 8) | (payload[i + 2] << 16) |
+                          (static_cast<uint32_t>(payload[i + 3]) << 24));
+  if (++g.fillCount == g.fillNeeded) {
+    ctx->mem->write16(hdrAddr(g.fillStart), 2); // complete
+    g.ready.push_back(g.fillStart);
+    g.writeSlot = (g.fillStart + g.fillNeeded) % g.ringSize;
+    g.filling = false;
+    if (trace())
+      fmt::print(stderr, "[ST] frame {} complete at slot {} ({} sectors)\n",
+                 frame, g.fillStart, g.fillNeeded);
+  }
+}
+
+// StSetRing(ring_addr, ring_size)
+void hle_st_StSetRing(recomp_context *ctx) {
+  g.ringBase = ctx->r[A0];
+  g.ringSize = ctx->r[A1];
+  clearRing(ctx);
+  ctx->r[V0] = 1;
+}
+
+// StClearRing()
+void hle_st_StClearRing(recomp_context *ctx) {
+  clearRing(ctx);
+  ctx->r[V0] = 0;
+}
+
+// StUnSetRing() -- stop feeding the ring.
+void hle_st_StUnSetRing(recomp_context *ctx) {
+  g.active = false;
+  g.filling = false;
+  ctx->r[V0] = 0;
+}
+
+// StSetStream(mode, start_frame, end_frame, func1, func2)
+void hle_st_StSetStream(recomp_context *ctx) {
+  g.startFrame = ctx->r[A1];
+  g.endFrame = ctx->r[A2];
+  ctx->r[V0] = 0;
+}
+
+// StSetMask(mask, start_frame, end_frame)
+void hle_st_StSetMask(recomp_context *ctx) {
+  g.startFrame = ctx->r[A1];
+  g.endFrame = ctx->r[A2];
+  ctx->r[V0] = 0;
+}
+
+// CdRead2(mode) -- Setmode, then ReadS from the current Setloc position.
+void hle_st_CdRead2(recomp_context *ctx) {
+  const uint8_t mode = static_cast<uint8_t>(ctx->r[A0]);
+  cdCommand(ctx, 0x0E, &mode, 1);
+  g.active = true;
+  g.filling = false;
+  cdCommand(ctx, 0x1B, nullptr, 0);
+  ctx->r[V0] = 1;
+}
+
+// StGetNext(u_long **addr, u_long **header): 0 and the oldest complete frame,
+// or 1 when none is ready.
+void hle_st_StGetNext(recomp_context *ctx) {
+  if (g.ready.empty()) {
+    ctx->r[V0] = 1;
+    return;
+  }
+  const uint32_t slot = g.ready.front();
+  g.ready.pop_front();
+  const uint32_t n = ctx->mem->read16(hdrAddr(slot) + 6); // sector count
+  ctx->mem->write16(hdrAddr(slot), 4);                     // held
+  g.held.emplace_back(slot, n ? n : 1);
+  ctx->mem->write32(ctx->r[A0], dataAddr(slot));
+  ctx->mem->write32(ctx->r[A1], hdrAddr(slot));
+  ctx->r[V0] = 0;
+}
+
+// StFreeRing(u_long *base): release the frame whose payload starts at base.
+void hle_st_StFreeRing(recomp_context *ctx) {
+  const uint32_t base = ctx->r[A0];
+  for (auto it = g.held.begin(); it != g.held.end(); ++it) {
+    if (dataAddr(it->first) != base)
+      continue;
+    for (uint32_t i = 0; i < it->second; ++i)
+      ctx->mem->write16(hdrAddr(it->first + i), 0);
+    g.held.erase(it);
+    ctx->r[V0] = 0;
+    return;
+  }
+  ctx->r[V0] = 1;
+}
+
+void psyq_register_st() {
+  psyq_register("st_StSetRing", &hle_st_StSetRing);
+  psyq_register("st_StClearRing", &hle_st_StClearRing);
+  psyq_register("st_StUnSetRing", &hle_st_StUnSetRing);
+  psyq_register("st_StSetStream", &hle_st_StSetStream);
+  psyq_register("st_StSetMask", &hle_st_StSetMask);
+  psyq_register("st_CdRead2", &hle_st_CdRead2);
+  psyq_register("st_StGetNext", &hle_st_StGetNext);
+  psyq_register("st_StFreeRing", &hle_st_StFreeRing);
+}
+
+} // namespace ps1::psyq
