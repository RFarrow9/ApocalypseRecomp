+// "A>o1>o2" -> {A, o1, o2}
+std::vector<uint32_t> parseChain(const std::string &s) {
+  std::vector<uint32_t> chain;
+  size_t pos = 0;
+  while (pos <= s.size()) {
+    const size_t gt = s.find('>', pos);
+    const std::string part = s.substr(pos, gt == std::string::npos ? gt : gt - pos);
+    chain.push_back(static_cast<uint32_t>(std::strtoul(part.c_str(), nullptr, 16)));
+    if (gt == std::string::npos)
+      break;
+    pos = gt + 1;
+  }
+  return chain;
+}
+
+bool isRam(uint32_t a) { return (a & 0x1FFFFFFF) < 0x200000 && a != 0; }
+
+// Follows a chain; false when a pointer on the way is null or not RAM.
+bool resolve(const std::vector<uint32_t> &chain, const CheatHost &host,
+             uint32_t &addr) {
+  if (chain.empty())
+    return false;
+  addr = chain[0];
+  for (size_t i = 1; i < chain.size(); i++) {
+    const uint32_t p = host.read32(addr);
+    if (!isRam(p))
+      return false;
+    addr = p + chain[i];
+  }
+  return true;
+}
