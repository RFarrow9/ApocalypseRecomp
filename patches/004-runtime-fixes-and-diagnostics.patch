+      continue;
+    }
+    if (!expectedBoot.empty() && upper(boot) != upper(expectedBoot)) {
+      tell(gameName, "That disc boots " + boot + ", but this port needs " +
+                         gameName + " (" + expectedBoot +
+                         ").\n\nSelect the right disc image.");
+      continue;
+    }
+    writeIniDisc(settingsIni, utf8(cue));
+    return DiscPaths{utf8(cue), *exe};
