   ctx->mem->write32(aligned, word);
 }
 
+// DIV/DIVU with R3000A results for the cases C++ leaves undefined.  Division
+// by zero does not trap on hardware: LO = (n >= 0 ? -1 : 1) for DIV, all ones
+// for DIVU, and HI = n.  0x80000000 / -1 gives LO = 0x80000000, HI = 0 (on x86
+// the native idiv faults).  Out of line from the emitted code so a constant
+// zero divisor, which appears when data is decoded as code, still compiles.
+inline void DO_DIV(recomp_context *ctx, int32_t n, int32_t d) {
+  if (d == 0) {
+    ctx->lo = n >= 0 ? 0xFFFFFFFFu : 1u;
+    ctx->hi = static_cast<uint32_t>(n);
+  } else if (n == INT32_MIN && d == -1) {
+    ctx->lo = 0x80000000u;
+    ctx->hi = 0;
+  } else {
+    ctx->lo = static_cast<uint32_t>(n / d);
+    ctx->hi = static_cast<uint32_t>(n % d);
+  }
+}
+
+inline void DO_DIVU(recomp_context *ctx, uint32_t n, uint32_t d) {
+  if (d == 0) {
+    ctx->lo = 0xFFFFFFFFu;
+    ctx->hi = n;
+  } else {
+    ctx->lo = n / d;
+    ctx->hi = n % d;
+  }
+}
+
